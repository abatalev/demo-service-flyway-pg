FROM ghcr.io/abatalev/covaggregator:0.1.4

WORKDIR /app

# Копируем предварительно собранные отчёты JaCoCo из example
COPY service/src/main/java/ ./data/things-service/sources
COPY service/target/classes/ ./data/things-service/classes
COPY service/target/jacoco.exec ./data/things-service/

COPY stub/src/main/java/ ./data/things-stub/sources
COPY stub/target/classes/ ./data/things-stub/classes
COPY stub/target/jacoco.exec ./data/things-stub/

# Создаём конфигурационный файл-пример
COPY covaggr/config.yaml ./config.yaml

EXPOSE 8080

CMD [ "--config", "/app/config.yaml"]